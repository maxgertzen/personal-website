# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_SECRET=

# Fastmail SMTP for the contact form.
# Create an app-specific password: Fastmail → Settings → Privacy & Security →
# "App passwords" → new password with access to "Mail (SMTP/IMAP)".
FASTMAIL_SMTP_USER=max@maxgertzen.com
FASTMAIL_SMTP_PASSWORD=

# Optional — where contact submissions are delivered. Defaults to FASTMAIL_SMTP_USER.
CONTACT_TO_EMAIL=
